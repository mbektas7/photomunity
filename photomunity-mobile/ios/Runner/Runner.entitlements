<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal Links: https://photomunity.com/… bağlantıları uygulamayı açar.
	     Sunucuda /.well-known/apple-app-site-association gerekir (photomunity-web). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:photomunity.com</string>
	</array>
	<!-- Apple ile giriş -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Push bildirimleri (dağıtım imzasında production'a çevrilir) -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
