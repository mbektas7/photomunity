# Sunucu tarafı: FastAPI adresi (tarayıcı bu adrese doğrudan gitmez)
API_URL=http://localhost:8000/api/v1

# Sosyal giriş (boş bırakılırsa buton gösterilmez)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_REDIRECT_URI=http://localhost:3000

# Gerçek zamanlı mesajlar: tarayıcının bağlanacağı API WebSocket adresi
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws

# Harita altlığı (MapLibre stil adresi). Varsayılan: OpenFreeMap (ücretsiz, anahtarsız)
NEXT_PUBLIC_MAP_STYLE_LIGHT=https://tiles.openfreemap.org/styles/positron
NEXT_PUBLIC_MAP_STYLE_DARK=https://tiles.openfreemap.org/styles/dark

# Reklamlar (Google AdSense). Boşsa reklam alanı hiç çizilmez.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_FEED=
NEXT_PUBLIC_ADSENSE_SLOT_BANNER=

# Tanıtım sayfası ve SEO
NEXT_PUBLIC_SITE_URL=https://photomunity.com     # canonical, hreflang, site haritası ve paylaşım görseli adresleri
NEXT_PUBLIC_STATS_MIN=20                         # sayılar şeridi bu kadar kullanıcıdan itibaren gösterilir
NEXT_PUBLIC_APP_STORE_URL=                       # boşsa bağlantı gösterilmez
NEXT_PUBLIC_PLAY_STORE_URL=

# Yasal sayfalar (/privacy, /terms): şirket unvanı ve iletişim adresi. Boşsa sayfada uyarı görünür.
NEXT_PUBLIC_LEGAL_ENTITY=
NEXT_PUBLIC_CONTACT_EMAIL=

# Uygulama bağlantıları (Universal Links / App Links)
APPLE_TEAM_ID=
ANDROID_CERT_SHA256=
