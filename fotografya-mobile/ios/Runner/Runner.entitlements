<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal Links: https://fotografya.app/… bağlantıları uygulamayı açar.
	     Sunucuda /.well-known/apple-app-site-association gerekir (fotografya-web). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:fotografya.app</string>
	</array>
</dict>
</plist>
