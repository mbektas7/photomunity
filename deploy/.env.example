# Photomunity sunucu ayarları. Kopyala: cp .env.example .env  (.env git'e girmez)
# Rastgele değer üretmek için: openssl rand -hex 32

# ---- Zorunlu ----
DOMAIN=photomunity.com
POSTGRES_PASSWORD=                # openssl rand -hex 24
MINIO_ROOT_USER=photomunity
MINIO_ROOT_PASSWORD=              # openssl rand -hex 24
JWT_SECRET=                       # openssl rand -hex 32
RESEND_API_KEY=
EMAIL_FROM=Photomunity <no-reply@photomunity.com>

# Yasal sayfalar (/privacy, /terms)
NEXT_PUBLIC_LEGAL_ENTITY=
NEXT_PUBLIC_CONTACT_EMAIL=

# ---- Sosyal giriş (boşsa düğme görünmez) ----
GOOGLE_CLIENT_IDS=[]
APPLE_CLIENT_IDS=["app.photomunity.photomunity"]
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_CLIENT_ID=

# ---- Uygulama bağlantıları (Universal Links / App Links) ----
APPLE_TEAM_ID=3C8FGT67DB
ANDROID_CERT_SHA256=

# ---- Push (Firebase servis hesabı JSON'u, tek satır) ----
FCM_SERVICE_ACCOUNT_JSON=

# ---- Pro abonelik ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_SECRET_KEY=

# ---- İsteğe bağlı ----
TURNSTILE_SECRET=
MODERATION_PROVIDER=none
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_FEED=
NEXT_PUBLIC_ADSENSE_SLOT_BANNER=
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=

# GIPHY: mesajlarda GIF ve çıkartma (developers.giphy.com). Boşsa GIF araması kapalı.
GIPHY_API_KEY=
